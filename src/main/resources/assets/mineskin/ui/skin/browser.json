{
  "type": "column",
  "id": "root",
  "width": "100%",
  "height": "100%",
  "padding": 12,
  "gap": 8,
  "children": [
    {
      "type": "row",
      "id": "header",
      "width": "100%",
      "height": 26,
      "align": "center",
      "gap": 8,
      "children": [
        {
          "type": "row",
          "width": "25%",
          "gap": 8,
          "align": "center",
          "children": [
            {
              "type": "item",
              "item": "minecraft:player_head",
              "scale": 1.2,
              "tooltip": "皮肤浏览器"
            },
            {
              "type": "text",
              "text": "{state.title}",
              "color": "#FFFFFF",
              "scale": 1.4
            }
          ]
        },
        {
          "type": "input",
          "id": "search",
          "width": "55%",
          "height": 22,
          "placeholder": "搜索皮肤（回车）",
          "maxLength": 32,
          "action": "search",
          "skin": "vanilla:input"
        },
        {
          "type": "row",
          "width": "40%",
          "justify": "end",
          "align": "center",
          "children": [
            {
              "type": "button",
              "text": "关闭",
              "action": "close",
              "skin": "vanilla:button",
              "hoverScale": 1.05
            }
          ]
        }
      ]
    },
    {
      "type": "row",
      "id": "meta",
      "width": "100%",
      "height": 12,
      "align": "center",
      "justify": "space-between",
      "children": [
        {
          "type": "text",
          "text": "{state.subtitle}",
          "color": "#A0A0A0"
        },
        {
          "type": "row",
          "gap": 5,
          "align": "center",
          "children": [
            {
              "type": "image",
              "texture": "mineui:textures/gui/icon_heart.png",
              "width": 10,
              "height": 10
            },
            {
              "type": "text",
              "text": "悬停预览 · 点击锁定/取消 · 回车搜索 · 滚轮缩放",
              "color": "#707070"
            }
          ]
        }
      ]
    },
    {
