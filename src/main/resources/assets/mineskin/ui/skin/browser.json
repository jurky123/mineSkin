                  "width": "100%",
                  "height": 26,
                  "padding": {
                    "left": 6,
                    "right": 6
                  },
                  "gap": 6,
                  "align": "center",
                  "tooltip": "{state.slots.0.tooltip}",
                  "children": [
                    {
                      "type": "box",
                      "width": 5,
                      "height": 16,
                      "radius": 2,
                      "visible": "{state.slots.0.selected}",
                      "cycle": {
                        "interval": 1.0,
                        "colors": [
                          "#FFD700",
                          "#FFAA00",
                          "#FFD700"
                        ]
                      }
                    },
                    {
                      "type": "text",
