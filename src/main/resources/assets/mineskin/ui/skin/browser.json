            {
              "type": "column",
              "id": "previewFrame",
              "width": "100%",
              "height": "60%",
              "padding": 8,
              "gap": 4,
              "align": "center",
              "children": [
                {
                  "type": "row",
                  "gap": 5,
                  "align": "center",
                  "children": [
                    {
                      "type": "image",
                      "texture": "mineui:textures/gui/icon_star.png",
                      "width": 12,
                      "height": 12
                    },
                    {
                      "type": "text",
                      "text": "3D 预览",
                      "color": "#A0A0A0"
                    }
                  ]
                },
                {
                  "type": "player",
                  "id": "preview",
                  "width": "100%",
                  "height": "100%",
                  "scale": 45,
                  "followMouse": true,
                  "skin": {
                    "value": "{state.preview.value}",
                    "signature": "{state.preview.signature}"
                  },
                  "zoomable": true,
                  "tooltip": "滚轮缩放",
                  "zoomMin": 0.5,
                  "zoomMax": 2.0
                }
              ],
              "skin": "vanilla:panel",
              "clip": true
            },
            {
              "type": "text",
              "text": "{state.preview.name}",
              "color": "#FFFFFF",
              "width": "100%",
              "align": "center"
            },
            {
              "type": "button",
              "text": "应用该皮肤",
              "action": "apply",
              "width": "100%",
              "height": 22,
              "skin": "vanilla:button",
              "hoverScale": 1.04
            },
            {
              "type": "button",
              "text": "清除皮肤",
              "action": "clear",
              "width": "100%",
              "height": 18,
              "skin": "vanilla:button",
              "hoverScale": 1.03
            },
