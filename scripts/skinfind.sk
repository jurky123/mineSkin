command /skinfind <text>:
    trigger:
        if player is not set:
            send "&c该命令只能由玩家使用" to sender
            stop
        set {_count} to 0
        loop {skindata::*}:
            if "%loop-value%" contains "%arg-1%":
                add 1 to {_count}
        if {_count} is 0:
            send "&7没有找到「%arg-1%」相关皮肤，试试英文关键词：spider / anime / girl / boy / cat" to player
            stop
        execute console command "tellraw %player% {text:'为你找到 %{_count}% 个皮肤（最多显示 10 个）：',color:'green'}"
        set {_shown} to 0
        loop {skindata::*}:
            if "%loop-value%" contains "%arg-1%":
                if {_shown} < 10:
                    add 1 to {_shown}
                    execute console command "tellraw %player% {text:'',extra:[{text:'[换] ',color:'green',click_event:{action:'run_command',command:'/skin %loop-index%'}},{text:'%loop-value%',color:'white'}]}"
